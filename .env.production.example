# MoveOS — variables de entorno de producción
# Copiar a la plataforma de hosting (Render/Railway/Fly) como secretos.

# --- API (obligatorias) ---
NODE_ENV=production
# Secreto JWT fuerte (>=32 chars). Generar: openssl rand -base64 48
JWT_SECRET=
# Postgres gestionado (Supabase / Neon). Usar el "connection string" con sslmode=require.
DATABASE_URL=
# Orígenes permitidos para CORS, separados por coma (sin barra final).
CORS_ORIGINS=https://app.moveos.co,https://admin.moveos.co
PORT=3000

# --- Frontends (Vercel / Cloudflare Pages) ---
# URL pública de la API; cada app la lee como VITE_API_URL en build.
VITE_API_URL=https://api.moveos.co

# --- Almacenamiento de evidencias POD (Supabase Storage) ---
# Proyecto "Move OS" ya provisionado; el bucket pod-photos ya existe.
SUPABASE_URL=https://mervcbeedbcruqcipuvr.supabase.co
# Dashboard Supabase → Project Settings → API → service_role (NUNCA en frontends)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=pod-photos
# URL pública de la API (para construir URLs de archivos en modo disco local)
PUBLIC_API_URL=
# URL pública del dashboard (para construir enlaces de rastreo /t/<token>
# en las notificaciones B2B), p. ej. https://move-os-web-kappa.vercel.app
PUBLIC_WEB_URL=

# --- Proveedores externos (opcionales; hay adaptadores mock en desarrollo) ---
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
GOOGLE_MAPS_API_KEY=

# --- Telemática (fase 2, cuando se integre hardware real) ---
# URL/token del agregador (Flespi/Wialon) que retransmite a /telematics/ingest.
TELEMATICS_AGGREGATOR_URL=
TELEMATICS_AGGREGATOR_TOKEN=
