// MoveOS — esquema de datos multi-tenant.
// Los "enums" del dominio se modelan como String + validación Zod/TS en
// @moveos/shared para mantener flexibilidad de evolución sin migraciones.

generator client {
  provider      = "prisma-client-js"
  // "native" para desarrollo local; "debian-openssl-3.0.x" para la imagen
  // Docker de producción (Render usa Debian con OpenSSL 3).
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

/// Operador de la plataforma MoveOS (NO pertenece a ningún tenant). Gestiona
/// tenants, planes, módulos y salud desde el panel de administración.
model PlatformAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  nit       String?
  city      String   @default("Bogotá")
  status    String   @default("ACTIVE") // ACTIVE | SUSPENDED (panel de plataforma)
  plan      String   @default("FREE") // FREE | PRO | ENTERPRISE (etiqueta comercial)
  // Fleet-as-a-service: SELF_SERVE (se registró solo) | SUB_OPERATOR (cliente
  // con vehículos de MOVE en sitio, aprovisionado por la plataforma) |
  // PLATFORM_FLEET (el tenant operativo del propio MOVE).
  operatorType   String  @default("SELF_SERVE")
  parentTenantId String?
  // Oferta comercial: SAAS (software autoservicio) | FAAS (flota de MOVE en
  // sitio) | LOGISTICS_3PL (operación logística completa). Ortogonal a
  // operatorType (mecánica de aprovisionamiento / propiedad de activos):
  // etiqueta + preset de módulos al aprovisionar, nunca lógica de cobro.
  businessModel String   @default("SAAS")
  createdAt DateTime @default(now())

  entitlements  ModuleEntitlement[]
  users         User[]
  drivers       Driver[]
  vehicles      Vehicle[]
  clients       Client[]
  orders        Order[]
  routes        Route[]
  addressPins   AddressPin[]
  telemetry     TelemetryPing[]
  commands      VehicleCommand[]
  safetyAlerts  SafetyAlert[]
  notifications NotificationLog[]
  dailyMetrics  DailyTenantMetric[]
  chargingStations ChargingStation[]
}

/// Rollup diario de métricas por tenant (fuente: Order/Route/RouteStop).
/// Recomputable e idempotente: ver docs/planning/ANALYTICS_ARCHITECTURE.md.
/// El día se corta en America/Bogota (sin horario de verano).
model DailyTenantMetric {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  date             String // YYYY-MM-DD (día local Bogotá; coincide con Route.date)
  ordersCreated    Int      @default(0)
  ordersDelivered  Int      @default(0)
  ordersFailed     Int      @default(0) // FAILED + REJECTED
  routesPlanned    Int      @default(0)
  stopsCompleted   Int      @default(0)
  totalDistanceKm  Float    @default(0)
  totalDurationMin Int      @default(0)
  activeDrivers    Int      @default(0) // conductores con ruta ese día
  co2Kg            Float    @default(0)
  co2SavedKg       Float    @default(0)
  computedAt       DateTime @updatedAt

  @@unique([tenantId, date])
  @@index([date])
}

/// Bitácora del plano de plataforma: toda mutación del operador MOVE queda
/// registrada (quién, qué, sobre qué tenant/usuario, con diff en details).
model PlatformAuditLog {
  id             String   @id @default(cuid())
  adminId        String
  adminEmail     String // desnormalizado: legible aunque se elimine el admin
  action         String // TENANT_PROVISION | TENANT_UPDATE | MODULE_TOGGLE | VEHICLE_ASSIGN | USER_CREATE | USER_UPDATE | USER_RESET_PASSWORD | USER_DELETE
  targetTenantId String?
  targetUserId   String?
  details        Json
  createdAt      DateTime @default(now())

  @@index([targetTenantId, createdAt])
  @@index([createdAt])
}

model ModuleEntitlement {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  moduleKey String
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([tenantId, moduleKey])
}

model User {
  id           String  @id @default(cuid())
  tenantId     String
  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String  @unique
  passwordHash String
  name         String
  role         String  // ADMIN | DISPATCHER | DRIVER | CLIENT
  driver       Driver? @relation(fields: [driverId], references: [id])
  driverId     String? @unique
  // Portal de clientes: un usuario con rol CLIENT pertenece a un negocio
  // cliente y solo ve/crea pedidos de ese negocio. Un negocio puede tener
  // varios usuarios (gerente + bodega), por eso no es @unique.
  client       Client? @relation(fields: [clientId], references: [id])
  clientId     String?
  createdAt    DateTime @default(now())

  @@index([clientId])
}

model Driver {
  id         String  @id @default(cuid())
  tenantId   String
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  phone      String
  documentId String
  status     String  @default("ACTIVE")
  user       User?
  routes     Route[]
  telemetry  TelemetryPing[]
  createdAt  DateTime @default(now())
}

model Vehicle {
  id             String    @id @default(cuid())
  // Quién OPERA el vehículo (scoping de todas las consultas operativas).
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Quién es DUEÑO del activo (fleet-as-a-service: MOVE presta el vehículo a
  // un sub-operador). Null = el operador es el dueño. Solo el plano de
  // plataforma agrega/lee a través de tenants por este campo.
  ownerTenantId  String?
  plate          String
  type           String // MOTO | BICICLETA | CARRO | VAN | CAMION
  capacityKg     Float
  capacityM3     Float?
  isElectric     Boolean   @default(false)
  batteryKwh     Float?
  nominalRangeKm Float?
  socPercent     Float? // último estado de carga conocido (EV)
  soatExpiresAt  DateTime?
  tecnoExpiresAt DateTime?
  // Telemática: último estado conocido (alimentado por TelemetryPing).
  engineOn       Boolean   @default(true)
  immobilized    Boolean   @default(false) // motor bloqueado por comando (relé)
  lastSpeedKmh   Float?    // fuente del interlock de seguridad (apagado solo si 0)
  lastSeenAt     DateTime?
  routes         Route[]
  telemetry      TelemetryPing[]
  commands       VehicleCommand[]
  createdAt      DateTime  @default(now())

  @@unique([tenantId, plate])
}

/// Cliente empresarial del tenant: el NEGOCIO que origina los envíos (tienda,
/// distribuidor, e-commerce). MoveOS es B2B: cuando un paquete se entrega, la
/// confirmación se notifica a este negocio cliente, NO al consumidor final que
/// recibe el paquete en la puerta.
model Client {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String // razón social / nombre del negocio
  contactName   String?
  email         String?
  phone         String?
  // Canal por el que el negocio recibe las confirmaciones de entrega.
  notifyChannel String   @default("IN_APP") // IN_APP | EMAIL | WHATSAPP | WEBHOOK
  webhookUrl    String?
  // Dirección de recogida registrada: origen por defecto de los pedidos que
  // el negocio crea desde su portal (recogida en su bodega/tienda).
  pickupAddressRaw String?
  pickupLat        Float?
  pickupLng        Float?
  pickupNotes      String?
  createdAt     DateTime @default(now())
  orders        Order[]
  notifications NotificationLog[]
  // Usuarios del portal de clientes (rol CLIENT) de este negocio.
  portalUsers   User[]

  @@index([tenantId])
}

model Order {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId        String?
  client          Client?   @relation(fields: [clientId], references: [id])
  trackingNumber  String?
  // Token opaco para la página pública de rastreo (no adivinable, distinto de
  // la guía MV-). Permite al negocio cliente seguir el envío sin login.
  trackingToken   String?   @unique
  externalRef     String?
  // Consumidor final / destino de la entrega (el conductor entrega aquí).
  // NO recibe notificaciones: en B2B se notifica al negocio cliente.
  customerName    String
  customerPhone   String
  addressRaw      String
  addressNotes    String?
  lat             Float?
  lng             Float?
  geocodeSource   String? // CLIENT | ADDRESS_PIN | MOCK | GOOGLE | LUPAP | MANUAL_PIN | DRIVER_PIN
  // Inteligencia de direcciones: confianza del geocodificado (0–1) y momento
  // en que un humano (despachador, conductor o cliente) confirmó el pin.
  geoConfidence     Float?
  addressVerifiedAt DateTime?
  // Recogida en origen (opcional): si está presente, el conductor recoge aquí
  // antes de entregar (modelo pickup→delivery). Sin pickup = flujo desde depósito.
  pickupLat       Float?
  pickupLng       Float?
  pickupAddressRaw String?
  pickupNotes     String?
  pickedUpAt      DateTime?
  status          String    @default("PENDING")
  weightKg        Float     @default(1)
  volumeM3        Float?
  timeWindowStart DateTime?
  timeWindowEnd   DateTime?
  priority        Int       @default(0)
  failureReason   String?
  deliveredAt     DateTime?
  // Recuperación B2B de entregas fallidas: el despachador marca el pedido y el
  // comercio (cliente) lo reprograma desde su portal. Nunca se contacta al
  // consumidor final.
  recoveryStatus    String  @default("NONE") // NONE | FLAGGED | RESCHEDULED | RESOLVED
  rescheduledFromId String? // pedido fallido que originó este reenvío
  createdAt       DateTime  @default(now())

  // Un pedido puede tener hasta 2 paradas: PICKUP (si hay recogida) y DELIVERY.
  stops  RouteStop[]
  events OrderEvent[]

  @@unique([tenantId, trackingNumber])
  @@index([tenantId, status])
}

/// Bitácora del pedido: historial auditable de cada evento del ciclo de vida
/// (trazabilidad de principio a fin, base de la página de rastreo).
model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String // CREATED | GEOCODED | ASSIGNED | DISPATCHED | IN_TRANSIT | ARRIVED | PICKED_UP | DELIVERED | FAILED | NOTIFIED
  details   String?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

/// Grafo de direcciones aprendido: pines GPS confirmados en entregas exitosas.
/// Es la respuesta a la informalidad de direcciones ("frente al colegio").
model AddressPin {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  addressKey     String // dirección normalizada (clave de búsqueda)
  lat            Float
  lng            Float
  city           String? // cobertura por ciudad para el monitor del flywheel
  referenceNotes String?
  source         String   @default("DELIVERY_CONFIRMED") // DELIVERY_CONFIRMED | DRIVER_CONFIRMED | DISPATCHER_CONFIRMED
  useCount       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, addressKey])
  @@index([tenantId, createdAt])
}

/// Contador diario de geocodificaciones por fuente. Es la métrica de unit
/// economics del grafo de direcciones: cada acierto del grafo (ADDRESS_PIN)
/// es una llamada a Google/Lupap que NO se pagó ("graph hit rate").
model GeocodeDailyStat {
  id       String @id @default(cuid())
  tenantId String
  date     String // YYYY-MM-DD (día local Bogotá)
  source   String // ADDRESS_PIN | LUPAP | GOOGLE | MOCK
  count    Int    @default(0)

  @@unique([tenantId, date, source])
  @@index([date])
}

model Route {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  date             String // YYYY-MM-DD
  status           String   @default("PLANNED")
  driverId         String?
  driver           Driver?  @relation(fields: [driverId], references: [id])
  vehicleId        String
  vehicle          Vehicle  @relation(fields: [vehicleId], references: [id])
  depotLat         Float
  depotLng         Float
  departureMin     Int
  totalDistanceKm  Float
  totalDurationMin Int
  warnings         String[]
  stops            RouteStop[]
  createdAt        DateTime @default(now())

  @@index([tenantId, date])
}

model RouteStop {
  id          String    @id @default(cuid())
  routeId     String
  route       Route     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id])
  kind        String    @default("DELIVERY") // PICKUP | DELIVERY
  sequence    Int
  etaMin      Int
  status      String    @default("PENDING")
  arrivedAt   DateTime?
  completedAt DateTime?
  pod         ProofOfDelivery?

  // Un pedido tiene a lo sumo una parada de cada tipo por ruta.
  @@unique([routeId, orderId, kind])
}

model ProofOfDelivery {
  id           String    @id @default(cuid())
  stopId       String    @unique
  stop         RouteStop @relation(fields: [stopId], references: [id], onDelete: Cascade)
  types        String[] // PHOTO | SIGNATURE | OTP | GEOFENCE
  photoUrl     String?
  signatureUrl String?
  receivedBy   String?
  notes        String?
  lat          Float?
  lng          Float?
  geofenceOk   Boolean?
  createdAt    DateTime  @default(now())
}

/// Directorio de estaciones de carga (núcleo EV, roadmap P0.4b). Las redes
/// públicas (Terpel Voltex, Enel X, EPM, Celsia) se comparten entre tenants
/// con tenantId null; un cargador de depósito pertenece a su tenant. La
/// disponibilidad en vivo (OCPP) es fase 3 — aquí vive el directorio estático
/// que alimenta la planificación con autonomía y el "cargador más cercano"
/// del conductor desde el día uno.
model ChargingStation {
  id         String   @id @default(cuid())
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  network    String // Terpel Voltex | Enel X | EPM | Celsia | DEPOSITO | ...
  address    String?
  city       String   @default("Bogotá")
  lat        Float
  lng        Float
  connectors String[] // CCS | CHAdeMO | TYPE_2 | SCHUKO
  powerKw    Float?
  dcFast     Boolean  @default(false)
  status     String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt  DateTime @default(now())

  @@index([city])
  @@index([tenantId])
}

model TelemetryPing {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  driverId   String?
  driver     Driver?  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicleId  String?
  vehicle    Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  routeId    String?
  lat        Float
  lng        Float
  speedKmh   Float?
  heading    Float?
  batterySoc Float?
  // Datos CAN bus (moto / camión liviano): nulos si el dispositivo no los expone.
  rpm          Float?
  odometerKm   Float?
  fuelLevelPct Float?
  coolantTempC Float?
  engineOn     Boolean?
  source       String   @default("PHONE") // PHONE | DEVICE | SIMULATOR
  recordedAt   DateTime @default(now())

  @@index([tenantId, driverId, recordedAt])
  @@index([tenantId, vehicleId, recordedAt])
}

/// Comando hacia el vehículo (encendido/apagado de motor vía relé del
/// dispositivo telemático). Es un registro auditable: quién, cuándo, por qué,
/// y el acuse del dispositivo. NO es una escritura al CAN bus.
model VehicleCommand {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicleId       String
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type            String // ENGINE_OFF | ENGINE_ON
  status          String   @default("PENDING") // PENDING | SENT | ACK | REJECTED
  requestedByUserId String?
  reason          String?
  rejectionReason String?
  createdAt       DateTime @default(now())
  ackAt           DateTime?

  @@index([tenantId, vehicleId, createdAt])
  @@index([vehicleId, status])
}

model SafetyAlert {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  driverId  String?
  routeId   String?
  type      String // ROUTE_DEVIATION | PANIC | LONG_STOP | GEOFENCE_EXIT
  lat       Float?
  lng       Float?
  details   String?
  status    String   @default("OPEN")
  createdAt DateTime @default(now())

  @@index([tenantId, status])
}

/// Registro de notificaciones enviadas al negocio cliente (no al consumidor).
model NotificationLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id])
  orderId   String?
  channel   String // WEBHOOK | WHATSAPP | EMAIL | CONSOLE
  recipient String
  template  String
  payload   Json
  status    String   @default("SENT") // SENT | FAILED
  createdAt DateTime @default(now())

  @@index([tenantId, clientId, createdAt])
}
