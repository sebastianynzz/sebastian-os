// MoveOS — esquema de datos multi-tenant.
// Los "enums" del dominio se modelan como String + validación Zod/TS en
// @moveos/shared para mantener flexibilidad de evolución sin migraciones.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  nit       String?
  city      String   @default("Bogotá")
  createdAt DateTime @default(now())

  entitlements  ModuleEntitlement[]
  users         User[]
  drivers       Driver[]
  vehicles      Vehicle[]
  orders        Order[]
  routes        Route[]
  addressPins   AddressPin[]
  codPayments   CodPayment[]
  codSettlements CodSettlement[]
  telemetry     TelemetryPing[]
  safetyAlerts  SafetyAlert[]
  notifications NotificationLog[]
}

model ModuleEntitlement {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  moduleKey String
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([tenantId, moduleKey])
}

model User {
  id           String  @id @default(cuid())
  tenantId     String
  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String  @unique
  passwordHash String
  name         String
  role         String  // ADMIN | DISPATCHER | DRIVER
  driver       Driver? @relation(fields: [driverId], references: [id])
  driverId     String? @unique
  createdAt    DateTime @default(now())
}

model Driver {
  id         String  @id @default(cuid())
  tenantId   String
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  phone      String
  documentId String
  status     String  @default("ACTIVE")
  user       User?
  routes     Route[]
  telemetry  TelemetryPing[]
  codPayments CodPayment[]
  codSettlements CodSettlement[]
  createdAt  DateTime @default(now())
}

model Vehicle {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plate          String
  type           String // MOTO | BICICLETA | CARRO | VAN | CAMION
  capacityKg     Float
  capacityM3     Float?
  isElectric     Boolean   @default(false)
  batteryKwh     Float?
  nominalRangeKm Float?
  socPercent     Float? // último estado de carga conocido (EV)
  soatExpiresAt  DateTime?
  tecnoExpiresAt DateTime?
  routes         Route[]
  createdAt      DateTime  @default(now())

  @@unique([tenantId, plate])
}

model Order {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trackingNumber  String?
  externalRef     String?
  customerName    String
  customerPhone   String
  addressRaw      String
  addressNotes    String?
  lat             Float?
  lng             Float?
  geocodeSource   String? // CLIENT | ADDRESS_PIN | MOCK | GOOGLE | LUPAP
  status          String    @default("PENDING")
  paymentType     String    @default("PREPAID")
  codAmount       Int? // pesos colombianos (COP, sin decimales)
  weightKg        Float     @default(1)
  volumeM3        Float?
  timeWindowStart DateTime?
  timeWindowEnd   DateTime?
  priority        Int       @default(0)
  failureReason   String?
  deliveredAt     DateTime?
  createdAt       DateTime  @default(now())

  stop       RouteStop?
  codPayment CodPayment?
  events     OrderEvent[]

  @@unique([tenantId, trackingNumber])
  @@index([tenantId, status])
}

/// Bitácora del pedido: historial auditable de cada evento del ciclo de vida
/// (trazabilidad de principio a fin, base de la página de rastreo).
model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String // CREATED | GEOCODED | ASSIGNED | DISPATCHED | IN_TRANSIT | ARRIVED | DELIVERED | FAILED | COD_COLLECTED | NOTIFIED
  details   String?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

/// Grafo de direcciones aprendido: pines GPS confirmados en entregas exitosas.
/// Es la respuesta a la informalidad de direcciones ("frente al colegio").
model AddressPin {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  addressKey     String // dirección normalizada (clave de búsqueda)
  lat            Float
  lng            Float
  referenceNotes String?
  source         String   @default("DELIVERY_CONFIRMED")
  useCount       Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, addressKey])
}

model Route {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  date             String // YYYY-MM-DD
  status           String   @default("PLANNED")
  driverId         String?
  driver           Driver?  @relation(fields: [driverId], references: [id])
  vehicleId        String
  vehicle          Vehicle  @relation(fields: [vehicleId], references: [id])
  depotLat         Float
  depotLng         Float
  departureMin     Int
  totalDistanceKm  Float
  totalDurationMin Int
  warnings         String[]
  stops            RouteStop[]
  createdAt        DateTime @default(now())

  @@index([tenantId, date])
}

model RouteStop {
  id          String    @id @default(cuid())
  routeId     String
  route       Route     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  orderId     String    @unique
  order       Order     @relation(fields: [orderId], references: [id])
  sequence    Int
  etaMin      Int
  status      String    @default("PENDING")
  arrivedAt   DateTime?
  completedAt DateTime?
  pod         ProofOfDelivery?
}

model ProofOfDelivery {
  id           String    @id @default(cuid())
  stopId       String    @unique
  stop         RouteStop @relation(fields: [stopId], references: [id], onDelete: Cascade)
  types        String[] // PHOTO | SIGNATURE | OTP | GEOFENCE
  photoUrl     String?
  signatureUrl String?
  receivedBy   String?
  notes        String?
  lat          Float?
  lng          Float?
  geofenceOk   Boolean?
  createdAt    DateTime  @default(now())
}

model CodPayment {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId      String    @unique
  order        Order     @relation(fields: [orderId], references: [id])
  driverId     String?
  driver       Driver?   @relation(fields: [driverId], references: [id])
  amount       Int // COP
  method       String // CASH | QR | DATAPHONE | PSE | NEQUI | DAVIPLATA
  status       String    @default("COLLECTED")
  collectedAt  DateTime  @default(now())
  settlement   CodSettlement? @relation(fields: [settlementId], references: [id])
  settlementId String?

  @@index([tenantId, status])
}

model CodSettlement {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  driverId       String
  driver         Driver   @relation(fields: [driverId], references: [id])
  expectedAmount Int
  receivedAmount Int
  status         String // SETTLED | DISCREPANCY
  notes          String?
  payments       CodPayment[]
  createdAt      DateTime @default(now())
}

model TelemetryPing {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  driverId   String
  driver     Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  routeId    String?
  lat        Float
  lng        Float
  speedKmh   Float?
  heading    Float?
  batterySoc Float?
  recordedAt DateTime @default(now())

  @@index([tenantId, driverId, recordedAt])
}

model SafetyAlert {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  driverId  String?
  routeId   String?
  type      String // ROUTE_DEVIATION | PANIC | LONG_STOP | GEOFENCE_EXIT
  lat       Float?
  lng       Float?
  details   String?
  status    String   @default("OPEN")
  createdAt DateTime @default(now())

  @@index([tenantId, status])
}

model NotificationLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId   String?
  channel   String // WHATSAPP | SMS | EMAIL | CONSOLE
  recipient String
  template  String
  payload   Json
  createdAt DateTime @default(now())
}
